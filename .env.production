# Public origin of the carpeta-clips bucket. This is not a secret.
# `next build` (including `opennextjs-cloudflare build`) inlines
# NEXT_PUBLIC_* into the client bundle. wrangler.jsonc `vars` are Worker
# runtime bindings and are not substituted into that bundle, so they cannot
# set this URL. A Workers Builds environment variable of the same name, if
# set, overrides this file because Next does not replace variables already
# present in the environment.
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.carpeta.cl
