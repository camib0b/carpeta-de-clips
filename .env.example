# Public origin of the carpeta-clips R2 bucket.
# lib/media-url.ts is the only place that builds self-hosted clip video URLs.
# When this is unset, mediaUrl() returns null and the modal keeps using YouTube.
#
# Committed defaults:
# - .env.production — `next build` / `opennextjs-cloudflare build` (inlined)
# - .env.development — `pnpm dev`
# Copy this file to .env.local to override either one.
# A Workers Builds variable named NEXT_PUBLIC_MEDIA_BASE_URL overrides
# .env.production because Next will not replace a variable already set in
# the environment. wrangler.jsonc `vars` do not inline into the client bundle.
# Changing the URL requires a new build.
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.carpeta.cl
