# Public origin of the carpeta-clips R2 bucket (custom domain).
# lib/media-url.ts reads this and is the only place that builds self-hosted
# clip video URLs. When it is unset, mediaUrl() returns null and playback
# stays on YouTube.
#
# Next inlines NEXT_PUBLIC_* at build time. Set it in .env.local for
# `pnpm dev`, and in the Cloudflare Workers build environment before
# `next build`. Changing it later requires a rebuild.
# Planned production value: https://media.carpeta.cl
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.carpeta.cl
