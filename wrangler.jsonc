{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "carpeta-de-clips",
  "compatibility_date": "2026-05-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "carpeta-de-clips"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "r2_buckets": [
    {
      "binding": "CLIPPED_XML",
      "bucket_name": "clipped-xml",
      "remote": true
    },
    {
      "binding": "MEDIA",
      "bucket_name": "carpeta-clips"
    }
    // Playback URLs still come only from mediaUrl() in lib/media-url.ts.
    // NEXT_PUBLIC_MEDIA_BASE_URL is inlined by `next build` from
    // `.env.production` (https://media.carpeta.cl). A `vars` entry here would
    // only exist on the Worker at runtime, after that inlining, so it does not
    // set the player URL. Restricted clips return null until a gated URL exists.
    // MEDIA writes the private-team inbox under inbox/<date>-<team>-<suffix>/.
    // It is not remote, so local dev does not upload into production.
    // media.carpeta.cl is a public custom domain: inbox objects are readable
    // at that host until a rule blocks the inbox/ prefix.
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carpeta-de-clips",
      "database_id": "6ac20d29-8e80-42d2-8330-ed7a7901d103",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
