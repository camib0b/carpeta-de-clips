{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "carpeta-de-clips",
  "compatibility_date": "2026-05-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "carpeta-de-clips"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "r2_buckets": [
    {
      "binding": "CLIPPED_XML",
      "bucket_name": "clipped-xml",
      "remote": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carpeta-de-clips",
      "database_id": "6ac20d29-8e80-42d2-8330-ed7a7901d103",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
