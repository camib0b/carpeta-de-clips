{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "carpeta-de-clips",
  "compatibility_date": "2026-05-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "carpeta-de-clips"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "r2_buckets": [
    {
      "binding": "CLIPPED_XML",
      "bucket_name": "clipped-xml",
      "remote": true
    }
    // Public clip MP4s live in R2 bucket `carpeta-clips` and are addressed by
    // URL, not by a Worker binding. `mediaUrl()` in lib/media-url.ts is the
    // only builder. Set NEXT_PUBLIC_MEDIA_BASE_URL (see .env.example; planned
    // value https://media.carpeta.cl) before `next build` — Next inlines it.
    // Restricted clips return null until a gated URL exists.
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carpeta-de-clips",
      "database_id": "6ac20d29-8e80-42d2-8330-ed7a7901d103",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
