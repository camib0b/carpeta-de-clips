{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "carpeta-de-clips",
  "compatibility_date": "2026-05-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "carpeta-de-clips"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "r2_buckets": [
    {
      "binding": "CLIPPED_XML",
      "bucket_name": "clipped-xml",
      "remote": true
    },
    {
      "binding": "MEDIA",
      "bucket_name": "carpeta-clips"
    },
    // Playback URLs still come only from mediaUrl() in lib/media-url.ts.
    // NEXT_PUBLIC_MEDIA_BASE_URL is inlined by `next build` from
    // `.env.production` (https://media.carpeta.cl). A `vars` entry here would
    // only exist on the Worker at runtime, after that inlining, so it does not
    // set the player URL. Restricted clips return null until a gated URL exists.
    // MEDIA is the public clip bucket behind media.carpeta.cl. It is not
    // remote, so local dev does not upload into production. Team-inbox
    // objects do not belong in this bucket.
    {
      "binding": "INBOX",
      "bucket_name": "carpeta-inbox"
    }
    // Private team-inbox videos, including multipart uploads. R2 buckets are
    // private until a custom domain or r2.dev public URL is enabled. Create
    // carpeta-inbox before deploying this Worker, and leave both of those off.
    // Do not attach media.carpeta.cl. remote stays unset so local dev writes
    // to local storage instead of production.
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carpeta-de-clips",
      "database_id": "6ac20d29-8e80-42d2-8330-ed7a7901d103",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TEAM_INBOX_ENABLED": "true"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
