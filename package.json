{
  "name": "carpeta-de-clips",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "dev": "next dev",
    "build": "NEXT_PRIVATE_STANDALONE=true next build",
    "build:cf": "opennextjs-cloudflare build --skipNextBuild",
    "start": "next start",
    "preview": "pnpm run build && pnpm run build:cf && opennextjs-cloudflare preview",
    "deploy": "pnpm run build && pnpm run build:cf && opennextjs-cloudflare deploy",
    "upload": "pnpm run build && pnpm run build:cf && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply carpeta-de-clips --local",
    "db:migrate:remote": "wrangler d1 migrations apply carpeta-de-clips --remote",
    "db:seed:generate": "tsx scripts/seed-d1-catalog.ts",
    "db:list-xml": "wrangler d1 execute carpeta-de-clips --local --command \"SELECT id, r2_xml_object_key FROM matches WHERE r2_xml_object_key IS NOT NULL ORDER BY played_on\"",
    "db:parity": "tsx scripts/verify-catalog-parity.ts",
    "test": "tsx --test \"lib/**/*.test.ts\" \"scripts/**/*.test.ts\""
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "^0.564.0",
    "next": "16.2.4",
    "react": "^19",
    "react-dom": "^19",
    "react-youtube": "^10.1.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.23.13",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "wrangler": "^4.95.0"
  }
}
